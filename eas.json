{
  "cli": {
    "version": ">= 12.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "BUNDLE_IDENTIFIER": "com.resx.cc"
      }
    },
    "preview": {
      "environment": "preview",
      "env": {
        "APP_ENV": "preview"
      },
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "apple": {
      "ios": {
        "appleId": "",
        "appleTeamId": ""
      }
    },
    "production": {
      "extends": "apple",
      "ios": {
        "ascAppId": ""
      }
    },
    "preview": {
      "extends": "apple",
      "ios": {
        "ascAppId": ""
      }
    }
  }
}